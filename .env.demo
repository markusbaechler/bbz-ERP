# Lokale Testumgebung: npm run demo:neu (Daten neu aufsetzen), npm run demo (Server http://localhost:3000/app/).
# Eigene Datenbank bbz_demo: `npm test` setzt nur bbz_test zurueck, die Demo-Daten bleiben erhalten.
# Nur synthetische Daten. Keine Verbindungen nach aussen: Mail wird nur protokolliert, Moodle ist nicht angebunden.
DATABASE_URL=postgres://bbz:bbz@localhost:5433/bbz_demo
PORT=3000
AUTH_MODE=dev
MIGRATE_ON_START=true
WORKER_IM_SERVER=true
MAIL_ADAPTER=protokoll
MOODLE_URL=
MOODLE_TOKEN=
