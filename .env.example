# --- Datenbank
DATABASE_URL=postgres://bbz:bbz@localhost:5433/bbz_test
PORT=3000
MIGRATE_ON_START=false

# --- Auth: dev (Header x-user-role/x-user) | entra (Bearer-JWT von Entra ID)
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://bbz-erp
ENTRA_ADMIN_ROLE=bbz.admin

# --- Outbox-Worker (Moodle, Webhooks, Mail)
WORKER_IM_SERVER=false
WORKER_INTERVALL_MS=15000

# --- Moodle (mybbz, Web-Service-Token von cometas)
MOODLE_URL=https://cometas.bankenberatungszentrum.ch
MOODLE_TOKEN=
MOODLE_STUDENT_ROLE_ID=5
MOODLE_EVENT_SECRET=

# --- Mail: protokoll (nur speichern) | graph (Microsoft 365 sendMail)
MAIL_ADAPTER=protokoll
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_ABSENDER=info@bankenberatung.ch
